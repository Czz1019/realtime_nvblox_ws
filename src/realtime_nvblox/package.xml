<?xml version="1.0"?>
<package format="3">
  <name>realtime_nvblox</name>
  <version>1.0.0</version>
  <description>Python-first RealSense + cuVSLAM + nvblox_torch reconstruction without Isaac ROS runtime dependencies.</description>
  <maintainer email="user@example.com">realtime_nvblox maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
