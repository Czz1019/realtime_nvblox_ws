Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY

    - Class: rviz_default_plugins/MarkerArray
      Name: Mesh
      Enabled: false
      Topic:
        Value: /realtime_nvblox/mesh

    - Class: rviz_default_plugins/PointCloud2
      Name: ESDF Slice
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /realtime_nvblox/esdf_slice
      Color Transformer: RGB8
      Position Transformer: XYZ
      Size (Pixels): 3
      Style: Points

    - Class: rviz_default_plugins/PointCloud2
      Name: ESDF 3D
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /realtime_nvblox/esdf_3d
      Color Transformer: RGB8
      Position Transformer: XYZ
      Size (Pixels): 3
      Style: Points
      Decay Time: 0

    - Class: rviz_default_plugins/Path
      Name: Camera Path
      Enabled: true
      Topic:
        Value: /realtime_nvblox/camera_path

    - Class: rviz_default_plugins/Pose
      Name: Camera Pose
      Enabled: true
      Topic:
        Value: /realtime_nvblox/camera_pose
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Width: 1400
  Height: 900
